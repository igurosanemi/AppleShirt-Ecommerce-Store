# ============================================================
# AppleShirt — Environment Variables Reference
# Copy the relevant block to backend/.env or frontend/.env.local
# Never commit actual .env files.
# ============================================================

# ---- BACKEND (backend/.env) --------------------------------

# Application
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Postgres via Docker)
# NOTE: port 5433 avoids conflict with any local Postgres on :5432
DATABASE_URL=postgresql+asyncpg://appuser:apppassword@localhost:5433/appledb

# Redis (via Docker)
REDIS_URL=redis://localhost:6379/0

# CORS — frontend origin allowed by the backend
FRONTEND_ORIGIN=http://localhost:3000

# ---- FRONTEND (frontend/.env.local) -----------------------

# Backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
